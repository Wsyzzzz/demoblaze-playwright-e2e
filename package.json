{
  "name": "demoblaze-playwright-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end test automation framework for DemoBlaze (Playwright + TypeScript): UI, API, security and performance checks.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke --project=chromium --project=api",
    "test:regression": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chrome --project=api",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:perf": "playwright test --project=perf",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "demo": "playwright test --grep \"LGN-004|CRT-025\" --project=chromium --headed --workers=1",
    "demo:edge-cases": "playwright test --grep \"LGN-006|LGN-007|LGN-008|CRT-029|CRT-032\" --project=chromium --headed --workers=1",
    "perf:load": "k6 run perf/k6/api-load.js",
    "report": "node scripts/open-report.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.59.1",
    "@types/node": "22.20.5",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-plugin-playwright": "2.12.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
