# Copy to .env and adjust. .env is git-ignored – never commit real credentials.

# Target environment (see src/config/env.ts). Individual URLs below override it.
TEST_ENV=prod
# BASE_URL=https://www.demoblaze.com
# API_URL=https://api.demoblaze.com

# How tests get a logged-in user:
#   per-worker (default) – each worker signs up its own throwaway account. Parallel-safe, no secrets needed.
#   env                  – use the account below. Forces a single worker so carts do not collide.
USER_STRATEGY=per-worker
VALID_USER=
VALID_PASSWORD=

# Browser timezone (used for the order-date check)
TIMEZONE=Asia/Kuala_Lumpur

# Performance budget for the Cart page (CRT-019), in milliseconds
CART_PAGE_BUDGET_MS=3000

# How many local HTML reports to keep (one per run, in reports/html/test_report_<date_time>/)
REPORT_HISTORY=10

# Set to 1 to start the run even if the pre-run health check finds DemoBlaze down or slow
# SKIP_HEALTH_CHECK=1
